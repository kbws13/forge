"""End-to-end tests against the real provider.

Skipped unless ``RUN_REAL_PROVIDER_TESTS=1`` — these calls are billed.
"""

from __future__ import annotations

import os

import pytest
from pydantic import ValidationError
from fastapi.testclient import TestClient

from app.core.config import Settings
from app.main import create_app
from tests.conftest import API_KEY

pytestmark = pytest.mark.real_provider


@pytest.fixture(scope="module")
def real_client():
    if os.environ.get("RUN_REAL_PROVIDER_TESTS") != "1":
        pytest.skip("set RUN_REAL_PROVIDER_TESTS=1 to call the real provider")
    # 真实 key 从 .env 读取（测试环境的 DEEPSEEK_API_KEY 是假的，仅用于 import）
    try:
        settings = Settings.load(env_file=".env")
    except ValidationError:
        pytest.skip("DEEPSEEK_API_KEY is not configured in .env")
    settings = settings.model_copy(update={"api_key": API_KEY})
    if not settings.deepseek_api_key or settings.deepseek_api_key.get_secret_value() == "sk-xxx":
        pytest.skip("DEEPSEEK_API_KEY is not configured in .env")
    app = create_app(settings)
    with TestClient(app) as test_client:
        yield test_client


def test_real_chat_memory_flow(real_client) -> None:
    headers = {"X-API-Key": "test-secret-key"}
    session = real_client.post(
        "/api/v1/sessions",
        json={"agent_id": "{{ spec.module_name }}", "user_id": "real-user"},
        headers=headers,
    ).json()["data"]

    first = real_client.post(
        "/api/v1/chat",
        json={
            "agent_id": "{{ spec.module_name }}",
            "user_id": "real-user",
            "message": "Remember the code KBWS_REAL_77. Reply with just OK.",
            "session_id": session["session_id"],
        },
        headers=headers,
    ).json()
    assert first["code"] == 0

    second = real_client.post(
        "/api/v1/chat",
        json={
            "agent_id": "{{ spec.module_name }}",
            "user_id": "real-user",
            "message": "What code did I ask you to remember? Reply with only the code.",
            "session_id": session["session_id"],
        },
        headers=headers,
    ).json()
    assert second["code"] == 0
    assert "KBWS_REAL_77" in second["data"]["content"]


def test_real_chat_tool_calling(real_client) -> None:
    headers = {"X-API-Key": "test-secret-key"}
    resp = real_client.post(
        "/api/v1/chat",
        json={
            "agent_id": "{{ spec.module_name }}",
            "user_id": "real-user",
            "message": "What is 2 plus 3?",
        },
        headers=headers,
    ).json()
    assert resp["code"] == 0
    assert "5" in resp["data"]["content"]


def test_real_chat_stream_emits_tool_trace(real_client) -> None:
    headers = {"X-API-Key": "test-secret-key"}
    with real_client.stream(
        "POST",
        "/api/v1/chat_stream",
        json={
            "agent_id": "{{ spec.module_name }}",
            "user_id": "real-trace-user",
            "message": "You must call the add tool to calculate 2 plus 3. Return only the result.",
        },
        headers=headers,
    ) as response:
        body = "".join(response.iter_text())

    events = _parse_sse_events(body)
    event_types = [event["type"] for event in events]
    sequences = [event["sequence"] for event in events]

    assert response.status_code == 200
    assert sequences == sorted(sequences)
    assert len({event["run_id"] for event in events}) == 1
    assert event_types.index("model_started") < event_types.index("tool_started")
    assert event_types.index("tool_started") < event_types.index("tool_finished")
    assert event_types.index("tool_finished") < event_types.index("run_finished")
    assert any(event.get("tool_name") == "add" for event in events)
    assert any("5" in event.get("tool_output", "") for event in events)


def _parse_sse_events(body: str) -> list[dict]:
    import json

    events = []
    for frame in body.split("\n\n"):
        data_lines = [line[6:] for line in frame.splitlines() if line.startswith("data: ")]
        if data_lines:
            events.append(json.loads("\n".join(data_lines)))
    return events

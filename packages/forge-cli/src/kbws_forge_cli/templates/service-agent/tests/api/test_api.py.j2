"""API contract tests (fake model, no paid calls)."""

from __future__ import annotations


def test_health_is_public(client) -> None:
    resp = client.get("/api/v1/health")
    assert resp.status_code == 200
    assert resp.json() == {"code": 0, "info": "ok", "data": {"status": "ok"}}


def test_agents_requires_api_key(client) -> None:
    resp = client.get("/api/v1/agents")
    assert resp.status_code == 401
    assert resp.json()["code"] == 40100


def test_agents_rejects_wrong_api_key(client) -> None:
    resp = client.get("/api/v1/agents", headers={"X-API-Key": "wrong"})
    assert resp.status_code == 403
    assert resp.json()["code"] == 40101


def test_agents_accepts_bearer_token(client, auth_headers) -> None:
    resp = client.get(
        "/api/v1/agents",
        headers={"Authorization": "Bearer test-secret-key"},
    )
    assert resp.status_code == 200
    assert resp.json()["code"] == 0
    agent_ids = [a["agent_id"] for a in resp.json()["data"]]
    assert "{{ spec.module_name }}" in agent_ids


def test_sessions_idempotent_for_same_agent_and_user(client, auth_headers) -> None:
    body = {"agent_id": "{{ spec.module_name }}", "user_id": "u1"}
    first = client.post("/api/v1/sessions", json=body, headers=auth_headers)
    second = client.post("/api/v1/sessions", json=body, headers=auth_headers)
    assert first.status_code == 200
    assert first.json()["data"]["session_id"] == second.json()["data"]["session_id"]


def test_unknown_agent_maps_to_404(client, auth_headers) -> None:
    resp = client.post(
        "/api/v1/sessions",
        json={"agent_id": "missing", "user_id": "u1"},
        headers=auth_headers,
    )
    assert resp.status_code == 404
    assert resp.json()["code"] == 40400


def test_validation_error_maps_to_40000(client, auth_headers) -> None:
    resp = client.post("/api/v1/sessions", json={"agent_id": ""}, headers=auth_headers)
    assert resp.status_code == 400
    assert resp.json()["code"] == 40000


def test_chat_returns_unified_envelope(client, auth_headers) -> None:
    session = client.post(
        "/api/v1/sessions",
        json={"agent_id": "{{ spec.module_name }}", "user_id": "u1"},
        headers=auth_headers,
    ).json()["data"]

    resp = client.post(
        "/api/v1/chat",
        json={
            "agent_id": "{{ spec.module_name }}",
            "user_id": "u1",
            "message": "hello",
            "session_id": session["session_id"],
        },
        headers=auth_headers,
    )
    assert resp.status_code == 200
    body = resp.json()
    assert body["code"] == 0
    assert "fake agent" in body["data"]["content"]
    assert body["data"]["duration_ms"] >= 0
    assert body["data"]["model_calls"] == 1
    assert body["data"]["tool_calls"] == 0
    assert body["data"]["usage"]["total_tokens"] == 0


def test_chat_stream_emits_sse_events(client, auth_headers) -> None:
    with client.stream(
        "POST",
        "/api/v1/chat_stream",
        json={"agent_id": "{{ spec.module_name }}", "user_id": "u1", "message": "hello"},
        headers=auth_headers,
    ) as response:
        body = "".join(response.iter_text())

    assert response.headers["content-type"].startswith("text/event-stream")
    assert "event: run_started" in body
    assert "event: model_started" in body
    assert "event: model_finished" in body
    assert "event: run_finished" in body
    assert "event: run_failed" not in body
    assert '"event_id":' in body
    assert '"sequence":' in body


def test_chat_stream_unknown_agent_emits_run_failed(client, auth_headers) -> None:
    with client.stream(
        "POST",
        "/api/v1/chat_stream",
        json={"agent_id": "missing", "user_id": "u1", "message": "hello"},
        headers=auth_headers,
    ) as response:
        body = "".join(response.iter_text())

    assert "event: run_failed" in body
    assert "error_code" in body


def test_chat_rejects_session_from_another_user(client, auth_headers) -> None:
    session = client.post(
        "/api/v1/sessions",
        json={"agent_id": "{{ spec.module_name }}", "user_id": "u1"},
        headers=auth_headers,
    ).json()["data"]

    resp = client.post(
        "/api/v1/chat",
        json={
            "agent_id": "{{ spec.module_name }}",
            "user_id": "u2",
            "message": "hello",
            "session_id": session["session_id"],
        },
        headers=auth_headers,
    )
    assert resp.status_code == 403
    assert resp.json()["code"] == 40300


def test_traces_list_and_detail_after_any_client_run(client, auth_headers) -> None:
    """Trace API 暴露所有来源的 run：模拟“外部客户端”发请求，UI 侧可查到。"""
    client.post(
        "/api/v1/chat",
        json={"agent_id": "{{ spec.module_name }}", "user_id": "u1", "message": "hello from curl"},
        headers=auth_headers,
    )

    listed = client.get("/api/v1/traces", headers=auth_headers)
    assert listed.status_code == 200
    runs = listed.json()["data"]
    assert len(runs) >= 1
    newest = runs[0]
    assert newest["agent_id"] == "{{ spec.module_name }}"
    assert newest["prompt"] == "hello from curl"
    assert newest["status"] == "finished"
    assert "events" not in newest

    detail = client.get(f"/api/v1/traces/{newest['run_id']}", headers=auth_headers)
    assert detail.status_code == 200
    full = detail.json()["data"]
    event_types = [event["type"] for event in full["events"]]
    assert "run_started" in event_types
    assert "run_finished" in event_types



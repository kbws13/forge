# ===== 环境 =====
APP_ENV=dev
DEBUG=true

# ===== 鉴权 =====
# 服务 API Key（X-API-Key / Bearer）。
# 注意：为空时鉴权会静默关闭！生产环境必须设置为强随机值。
API_KEY=please-set-a-strong-api-key

# ===== 日志 =====
LOG_DIR=logs
LOG_LEVEL=INFO

# 业务聚合层根目录
AGENTS_DIR=agents

# ===== Runtime 执行策略（留空/不设置表示不限制） =====
# RUN_TIMEOUT_SECONDS=120
# RUN_MAX_MODEL_CALLS=8
# RUN_MAX_TOOL_CALLS=16
# RUN_MAX_TOTAL_TOKENS=20000
# RUN_MAX_COST_USD=1.0
# RUN_MAX_CONCURRENCY=4
RUN_MODEL_RETRIES=0
RUN_TOOL_RETRIES=0
# JSON 数组；只有列出的工具才允许自动重试
# RUN_RETRYABLE_TOOLS=["search"]
RUN_RETRY_BACKOFF_SECONDS=0

# ===== 模型 =====
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Agent =====

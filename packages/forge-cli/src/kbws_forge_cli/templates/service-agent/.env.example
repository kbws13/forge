# ===== 环境 =====
APP_ENV=dev
DEBUG=true

# ===== 鉴权 =====
# 服务 API Key（X-API-Key / Bearer）。
# 注意：为空时鉴权会静默关闭！生产环境必须设置为强随机值。
API_KEY=please-set-a-strong-api-key

# ===== 日志 =====
LOG_DIR=logs
LOG_LEVEL=INFO

# 业务聚合层根目录
AGENTS_DIR=agents

# ===== 模型 =====
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Agent =====

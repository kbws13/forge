[project]
name = "{{ spec.name }}"
version = "0.1.0"
description = "Agent backend generated by forge ({{ spec.template }} template)"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
    "kbws-forge-runtime[openai]>={{ spec.runtime_min_version }}",
    "fastapi>=0.116,<1",
    "uvicorn[standard]>=0.35,<1",
    "pydantic-settings>=2.10,<3",
]

[dependency-groups]
dev = [
    "httpx>=0.28,<1",
    "pytest>=8.4,<10",
    "pytest-asyncio>=1.1,<2",
    "ruff>=0.12,<1",
]

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_test_loop_scope = "session"
asyncio_default_fixture_loop_scope = "session"
testpaths = ["tests"]
pythonpath = ["."]
markers = [
    "real_provider: calls a paid external model provider",
]

[tool.ruff]
line-length = 100
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "ASYNC"]
